# NextBus Commuter App - Environment Configuration

# Backend API URL
# Use: http://localhost:3000 for local development
# Use: http://192.168.x.x:3000 for mobile device testing (replace with your IP)
# Use: https://api.yourserver.com for production
EXPO_PUBLIC_API_URL=http://localhost:3000

# Use Mock Data
# Set to "true" to use mock data instead of backend API
# Useful for testing without backend running
EXPO_PUBLIC_USE_MOCK_DATA=false

# Enable Debug Logging
# Set to "true" for verbose console logging
EXPO_PUBLIC_DEBUG=false
